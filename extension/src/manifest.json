{
  "manifest_version": 3,
  "name": "Screen Recorder: tab, window & screen",
  "short_name": "Screen Recorder",
  "version": "1.0.0",
  "description": "Record a tab, a window or your whole screen with your voice and face. Click highlights, trim, and download MP4.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Screen Recorder",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["offscreen", "tabCapture", "storage", "unlimitedStorage", "scripting", "downloads"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "start-stop": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Start or stop recording this tab"
    }
  },
  "web_accessible_resources": [
    { "resources": ["camera.html", "camera.js", "fonts/inter-tight.woff2"], "matches": ["<all_urls>"] }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
